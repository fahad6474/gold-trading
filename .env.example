# Backend environment variables
# Copy this file to backend/.env and fill in values for local overrides,
# or set these as environment variables in your deployment platform (Railway, etc.)

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=https://your-app.vercel.app

# Directory for caching yfinance data (ephemeral is fine; cache just speeds things up)
CACHE_DIR=/tmp/gold-trading-cache
